# Resend (https://resend.com) voor het versturen van bevestigingsmails
RESEND_API_KEY=re_...
EMAIL_FROM="VV Pernis <stemmen@vvpernis.nl>"

# Willekeurige lange string, gebruikt om IP-adressen te hashen (rate limiting)
VOTE_SALT=verander-mij-in-iets-willekeurigs
